API_KEY=local-secret-key
LOG_LEVEL=INFO
# Local runs outside Docker:
DATABASE_URL=postgresql+asyncpg://payments:payments@localhost:5432/payments
RABBITMQ_URL=amqp://payments:payments@localhost:5672/
OUTBOX_POLL_INTERVAL_SECONDS=0.5
OUTBOX_BATCH_SIZE=50
GATEWAY_MIN_DELAY_SECONDS=2
GATEWAY_MAX_DELAY_SECONDS=5
GATEWAY_SUCCESS_RATE=0.9
WEBHOOK_TIMEOUT_SECONDS=5
PROCESSING_LEASE_SECONDS=30
CONSUMER_PREFETCH_COUNT=1
RETRY_DELAY_1_SECONDS=2
RETRY_DELAY_2_SECONDS=4
